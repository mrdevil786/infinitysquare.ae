---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { House, Building2, ShoppingBag, Palette, Hammer, Layers, Sparkles, CircleCheck } from '@lucide/astro';
import { mainServices, servicesData } from '../data/services';
import { projects as allProjects, featuredProjectsCount } from '../data/portfolio';
import { withBase } from '../utils/base';

const iconMap = { House, Building2, ShoppingBag, Palette, Hammer, Layers, Sparkles } as const;

const services = mainServices.map((s) => ({
  ...s,
  icon: iconMap[s.iconKey],
  image: withBase(s.image),
}));

const subServicesMap = Object.fromEntries(
  servicesData.map((s) => [s.id, { ...s, icon: iconMap[s.iconKey], image: withBase(s.image) }])
);

const projects = allProjects.slice(0, featuredProjectsCount).map((p) => ({
  ...p,
  image: withBase(p.image),
  images: p.images.map(withBase),
}));

const heroImageUrl = 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1920&q=80';
---

<Layout title="Home" preloadImage={heroImageUrl}>
  <Header />
  <main id="main-content">
  <!-- Hero Section -->
  <section class="relative h-screen min-h-[600px] sm:min-h-[700px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img 
        src={heroImageUrl} 
        alt="Luxury Interior" 
        width={1920}
        height={1080}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-primary/90"></div>
    </div>
    
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-gold font-medium tracking-[0.2em] text-xs sm:text-sm mb-4 sm:mb-6 uppercase">Premium Interior Design</p>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl text-white font-bold mb-6 sm:mb-8 leading-tight">
        Crafting Timeless<br/>Elegant Spaces
      </h1>
      <p class="text-zinc-300 text-base sm:text-lg md:text-xl max-w-xl sm:max-w-2xl mx-auto mb-8 sm:mb-10 leading-relaxed">
        We transform visions into stunning realities, creating interiors that inspire and endure.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center px-4 sm:px-0">
        <a 
          href={withBase('/contact')} 
          class="btn-secondary"
        >
          Start Your Project
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <a href="#our-services" class="absolute bottom-6 sm:bottom-10 left-1/2 -translate-x-1/2 animate-bounce text-white/60 hover:text-white transition-colors" aria-label="Scroll to services">
      <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7-7-7m14-8l-7 7-7-7" />
      </svg>
    </a>
  </section>

  <!-- Services Section -->
  <section id="our-services" class="py-16 sm:py-24 bg-zinc-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12 sm:mb-16">
        <p class="text-gold font-medium tracking-[0.2em] text-xs sm:text-sm mb-3 sm:mb-4 uppercase">What We Do</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-primary mb-4 sm:mb-6">Our Services</h2>
        <p class="text-zinc-600 max-w-xl mx-auto text-sm sm:text-base">
          Explore our specialized services. Click any service box below to view details and sub-services.
        </p>
      </div>

      <!-- 4 Main Service Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 mb-8">
        {services.map((service, index) => (
          <button
            type="button"
            class="service-card-btn group card-modern p-6 sm:p-8 text-left w-full cursor-pointer transition-all duration-300 transform hover:-translate-y-1 focus:outline-none flex flex-col justify-between border-2 border-zinc-100"
            data-service-trigger={service.id}
            aria-expanded={index === 1 ? 'true' : 'false'}
          >
            <div>
              <div class="flex items-center justify-between mb-4 sm:mb-6">
                <div class="w-12 h-12 gold-gradient rounded-xl flex items-center justify-center shadow-sm">
                  <service.icon class="w-6 h-6 text-white" />
                </div>
                <span class="text-xs font-semibold text-gold bg-gold/10 px-2.5 py-1 rounded-full uppercase tracking-wider">
                  0{index + 1}
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-semibold text-primary mb-2 sm:mb-3">{service.title}</h3>
              <p class="text-zinc-600 text-sm leading-relaxed">{service.shortDescription}</p>
            </div>
            
            <div class="pt-4 border-t border-zinc-100 mt-4 flex items-center justify-between text-gold font-semibold text-sm group-hover:text-primary transition-colors">
              <span>
                {service.id === 'interior-design'
                  ? 'View 3D Visualization'
                  : service.id === 'fit-out'
                  ? 'Explore 3 Core Services'
                  : 'View Service Details'}
              </span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </button>
        ))}
      </div>

      <!-- Inline Service Details Container (Renders directly below the 4 service boxes) -->
      <div id="service-detail-container" class="bg-white rounded-3xl p-6 sm:p-10 border border-zinc-200/80 shadow-xl transition-all duration-300">
        {services.map((service) => (
          <div id={`service-detail-${service.id}`} class="service-detail-panel hidden">
            
            <!-- Header -->
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 gold-gradient rounded-xl flex items-center justify-center">
                <service.icon class="w-5 h-5 text-white" />
              </div>
              <div>
                <p class="text-gold font-medium tracking-[0.2em] text-xs uppercase">Selected Category</p>
                <h3 class="text-2xl sm:text-3xl font-bold text-primary">{service.title}</h3>
              </div>
            </div>

            <p class="text-zinc-600 text-base leading-relaxed mb-6 border-b border-zinc-100 pb-6">
              {service.description}
            </p>

            <!-- BOX 2 SPECIAL: Interior Design -> Displays 3D Visualization -->
            {service.id === 'interior-design' && (
              <div class="space-y-6">
                <div class="bg-amber-50/60 border border-amber-200/60 p-4 rounded-2xl flex items-center gap-3">
                  <Sparkles class="w-5 h-5 text-gold flex-shrink-0" />
                  <p class="text-sm font-medium text-amber-900">
                    Includes full <strong>3D Visualization & Rendering</strong> before construction begins.
                  </p>
                </div>

                <!-- 3D Visualization Service Highlight Card (Clickable to /services#visualization) -->
                <a
                  href={withBase('/services#visualization')}
                  class="group/sub bg-zinc-50 rounded-2xl p-6 sm:p-8 border border-zinc-200/80 grid grid-cols-1 md:grid-cols-2 gap-6 items-center block hover:border-gold/50 hover:bg-white hover:shadow-lg transition-all duration-300"
                >
                  <div>
                    <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center mb-4">
                      <Palette class="w-5 h-5 text-gold" />
                    </div>
                    <h4 class="text-xl font-bold text-primary mb-2 group-hover/sub:text-gold transition-colors">{subServicesMap['visualization']?.title}</h4>
                    <p class="text-zinc-600 text-sm mb-4 leading-relaxed">{subServicesMap['visualization']?.description}</p>
                    
                    <h5 class="text-xs font-semibold uppercase tracking-wider text-gold mb-3">Key Features</h5>
                    <ul class="space-y-2 mb-4">
                      {subServicesMap['visualization']?.features.map((feat) => (
                        <li class="flex items-center gap-2 text-xs sm:text-sm text-zinc-700">
                          <CircleCheck class="w-4 h-4 text-gold flex-shrink-0" />
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>

                    <span class="inline-flex items-center gap-2 text-gold font-semibold text-sm group-hover/sub:gap-3 transition-all">
                      Learn More on Services Page
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </span>
                  </div>
                  <div class="relative rounded-xl overflow-hidden shadow-lg aspect-[4/3]">
                    <img
                      src={subServicesMap['visualization']?.image}
                      alt="3D Visualization & Rendering"
                      class="w-full h-full object-cover group-hover/sub:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-4">
                      <span class="text-white text-xs font-semibold bg-gold/90 px-3 py-1 rounded-full">3D Render Preview</span>
                    </div>
                  </div>
                </a>
              </div>
            )}

            <!-- BOX 3 SPECIAL: Fit Out Work -> Displays first 3 visible services (Residential, Commercial, Retail) -->
            {service.id === 'fit-out' && (
              <div class="space-y-6">
                <div class="bg-amber-50/60 border border-amber-200/60 p-4 rounded-2xl flex items-center gap-3">
                  <Layers class="w-5 h-5 text-gold flex-shrink-0" />
                  <p class="text-sm font-medium text-amber-900">
                    Our Fit Out Work encompasses <strong>Residential</strong>, <strong>Commercial</strong>, and <strong>Retail</strong> solutions. Click any service to view full details.
                  </p>
                </div>

                <!-- 3 Visible Services Grid (Clickable to /services#id) -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
                  {['residential', 'commercial', 'retail'].map((childId) => {
                    const child = subServicesMap[childId];
                    if (!child) return null;
                    return (
                      <a
                        href={withBase(`/services#${childId}`)}
                        class="group/sub bg-zinc-50 p-5 rounded-2xl border border-zinc-200/80 flex flex-col justify-between hover:border-gold/50 hover:bg-white hover:shadow-md transition-all duration-300 block"
                      >
                        <div>
                          <div class="w-10 h-10 gold-gradient rounded-xl flex items-center justify-center mb-3">
                            <child.icon class="w-5 h-5 text-white" />
                          </div>
                          <h4 class="text-lg font-bold text-primary mb-2 group-hover/sub:text-gold transition-colors">{child.title}</h4>
                          <p class="text-zinc-600 text-xs leading-relaxed mb-4">{child.shortDescription}</p>
                          
                          <ul class="space-y-1.5 mb-4">
                            {child.features.slice(0, 4).map((feat) => (
                              <li class="flex items-center gap-2 text-xs text-zinc-700">
                                <span class="w-1.5 h-1.5 rounded-full bg-gold flex-shrink-0"></span>
                                <span>{feat}</span>
                              </li>
                            ))}
                          </ul>
                        </div>

                        <div>
                          <div class="relative rounded-lg overflow-hidden aspect-[16/9] mb-3">
                            <img src={child.image} alt={child.title} class="w-full h-full object-cover group-hover/sub:scale-105 transition-transform duration-500" loading="lazy" />
                          </div>

                          <span class="inline-flex items-center gap-1.5 text-gold text-xs font-semibold group-hover/sub:gap-2 transition-all">
                            Learn More
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                          </span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}

            <!-- BOX 1 & BOX 4: Demolition & Mailatere (Standard Service Details) -->
            {service.id !== 'interior-design' && service.id !== 'fit-out' && (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 items-center">
                <div>
                  <h4 class="text-lg font-bold text-primary mb-3">Service Capabilities</h4>
                  <ul class="space-y-2.5 mb-6">
                    {service.features.map((feat) => (
                      <li class="flex items-center gap-3 text-sm text-zinc-700">
                        <CircleCheck class="w-5 h-5 text-gold flex-shrink-0" />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="relative rounded-2xl overflow-hidden shadow-md aspect-[4/3]">
                  <img src={service.image} alt={service.title} class="w-full h-full object-cover" loading="lazy" />
                </div>
              </div>
            )}

            <!-- Footer CTA -->
            <div class="mt-8 pt-6 border-t border-zinc-100 flex flex-col sm:flex-row items-center justify-between gap-4">
              <p class="text-xs text-zinc-500">Need customized solutions for your project?</p>
              <div class="flex items-center gap-3 w-full sm:w-auto">
                <a href={withBase('/contact')} class="btn-primary py-2.5 px-5 text-sm w-full sm:w-auto text-center">
                  Get In Touch
                </a>
                <a href={withBase(`/services#${service.id}`)} class="btn-secondary py-2.5 px-5 text-sm w-full sm:w-auto text-center border-zinc-300 text-zinc-800 hover:bg-zinc-100">
                  View on Services Page
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Inline Service Switcher Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const triggers = document.querySelectorAll('[data-service-trigger]');
      const panels = document.querySelectorAll('.service-detail-panel');

      function setActiveService(serviceId: string) {
        triggers.forEach((trigger) => {
          const id = trigger.getAttribute('data-service-trigger');
          if (id === serviceId) {
            trigger.classList.add('border-gold', 'ring-2', 'ring-gold/30', 'bg-white', 'shadow-xl');
            trigger.classList.remove('border-zinc-100');
            trigger.setAttribute('aria-expanded', 'true');
          } else {
            trigger.classList.remove('border-gold', 'ring-2', 'ring-gold/30', 'shadow-xl');
            trigger.classList.add('border-zinc-100');
            trigger.setAttribute('aria-expanded', 'false');
          }
        });

        panels.forEach((panel) => {
          panel.classList.add('hidden');
        });

        const activePanel = document.getElementById(`service-detail-${serviceId}`);
        if (activePanel) {
          activePanel.classList.remove('hidden');
        }
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const serviceId = trigger.getAttribute('data-service-trigger');
          if (serviceId) setActiveService(serviceId);
        });
      });

      // Default active service box on page load: 'interior-design' (Box 2)
      setActiveService('interior-design');

      // Featured projects carousel arrows logic
      document.querySelectorAll('.project-card').forEach((card) => {
        const img = card.querySelector('.carousel-img') as HTMLImageElement | null;
        const prevBtn = card.querySelector('.carousel-prev');
        const nextBtn = card.querySelector('.carousel-next');
        const counter = card.querySelector('.carousel-counter');

        if (!img) return;

        let images: string[] = [];
        try {
          images = JSON.parse(img.getAttribute('data-images') || '[]');
        } catch {
          images = [];
        }

        if (images.length <= 1) return;

        let currentIndex = 0;

        function updateImage(newIndex: number) {
          currentIndex = (newIndex + images.length) % images.length;
          if (img) {
            img.src = images[currentIndex];
            img.setAttribute('data-current-index', currentIndex.toString());
          }
          if (counter) {
            counter.textContent = `${currentIndex + 1} / ${images.length}`;
          }
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            updateImage(currentIndex - 1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            updateImage(currentIndex + 1);
          });
        }
      });
    });
  </script>

  <!-- Featured Projects -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row justify-between items-end mb-10 sm:mb-16 gap-4">
        <div>
          <p class="text-gold font-medium tracking-[0.2em] text-xs sm:text-sm mb-3 sm:mb-4 uppercase">Portfolio</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-primary">Featured Projects</h2>
        </div>
        <a href={withBase('/portfolio')} class="hidden sm:inline-flex items-center gap-2 text-primary font-semibold hover:text-gold transition-colors">
          View All Projects
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {projects.map((project) => (
          <div 
            class="project-card group block cursor-default select-none active:bg-transparent" 
            style="-webkit-tap-highlight-color: transparent;"
            data-project-id={project.id}
          >
            <div class="relative overflow-hidden aspect-[4/3] rounded-2xl mb-4 shadow-md group-hover:shadow-xl transition-shadow duration-300 bg-zinc-100">
              <img 
                src={project.image} 
                alt={project.title}
                width={800}
                height={600}
                loading="lazy"
                class="carousel-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 pointer-events-none select-none"
                data-images={JSON.stringify(project.images)}
                data-current-index="0"
              />

              {project.images && project.images.length > 1 && (
                <>
                  <!-- Carousel Left Arrow -->
                  <button
                    type="button"
                    class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/60 hover:bg-gold text-white flex items-center justify-center backdrop-blur-md opacity-90 sm:opacity-0 group-hover:opacity-100 transition-all duration-200 z-20 shadow-md hover:scale-110 cursor-pointer focus:outline-none"
                    aria-label="Previous image"
                  >
                    <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
                    </svg>
                  </button>

                  <!-- Carousel Right Arrow -->
                  <button
                    type="button"
                    class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/60 hover:bg-gold text-white flex items-center justify-center backdrop-blur-md opacity-90 sm:opacity-0 group-hover:opacity-100 transition-all duration-200 z-20 shadow-md hover:scale-110 cursor-pointer focus:outline-none"
                    aria-label="Next image"
                  >
                    <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                    </svg>
                  </button>

                  <!-- Image Counter -->
                  <div class="carousel-counter absolute bottom-3 right-3 bg-black/70 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full border border-white/20 z-10 pointer-events-none">
                    1 / {project.images.length}
                  </div>
                </>
              )}
            </div>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gold text-xs sm:text-sm font-medium tracking-wide mb-1">{project.category}</p>
                <h3 class="text-lg sm:text-xl font-semibold text-primary">{project.title}</h3>
              </div>
              {project.images && project.images.length > 1 && (
                <span class="text-xs font-medium text-zinc-400 bg-zinc-100 px-2.5 py-1 rounded-md">
                  {project.images.length} Photos
                </span>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10 sm:hidden">
        <a href={withBase('/portfolio')} class="inline-flex items-center gap-2 text-primary font-medium hover:text-gold transition-colors">
          View All Projects
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="py-16 sm:py-24 bg-zinc-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 sm:gap-16 items-center">
        <div class="relative order-2 lg:order-1">
          <img 
            src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=800&q=80" 
            alt="Design Studio"
            width={800}
            height={600}
            loading="lazy"
            class="w-full rounded-2xl shadow-lg"
          />
          <div class="absolute -bottom-4 sm:-bottom-8 -right-4 sm:-right-8 bg-primary text-white p-6 sm:p-8 rounded-2xl shadow-xl hidden lg:block">
            <p class="text-4xl sm:text-5xl font-bold tracking-tight">10+</p>
            <p class="text-zinc-400 text-sm">Years of Excellence</p>
          </div>
        </div>
        
        <div class="order-1 lg:order-2">
          <p class="text-gold font-medium tracking-[0.2em] text-xs sm:text-sm mb-3 sm:mb-4 uppercase">About Us</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-primary mb-4 sm:mb-6">
            Designing Spaces That Tell Your Story
          </h2>
          <p class="text-zinc-600 leading-relaxed mb-4 sm:mb-6 text-sm sm:text-base">
            At Infinity Square LLC, we believe that exceptional interior design goes beyond aesthetics—it's about creating spaces that reflect your unique personality and enhance your lifestyle.
          </p>
          <p class="text-zinc-600 leading-relaxed mb-6 sm:mb-8 text-sm sm:text-base">
            Our team of talented designers combines creativity with functionality to transform ordinary spaces into extraordinary environments that inspire and delight.
          </p>
          
          <div class="grid grid-cols-2 gap-6 sm:gap-8 mb-6 sm:mb-8">
            <div>
              <p class="text-3xl sm:text-4xl font-bold text-primary tracking-tight">200+</p>
              <p class="text-zinc-500 text-sm">Projects Completed</p>
            </div>
            <div>
              <p class="text-3xl sm:text-4xl font-bold text-primary tracking-tight">50+</p>
              <p class="text-zinc-500 text-sm">Happy Clients</p>
            </div>
          </div>

          <a href={withBase('/about')} class="btn-primary">
            Learn More About Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 sm:py-24 bg-primary relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(212,175,55,0.15),transparent)]"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4 sm:mb-6 tracking-tight">
        Ready to Transform Your Space?
      </h2>
      <p class="text-zinc-400 text-base sm:text-lg mb-8 sm:mb-10">
